<mxfile>
  <diagram id="autolayout" name="Page-1">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="group_0" value="Subtitle NLP Pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#def0dc;strokeColor=#5c8a49;fontColor=#5c8a49;verticalAlign=top;fontFamily=Comic Sans MS,cursive;fontStyle=0;dashed=0;strokeWidth=2;sketch=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="5" y="5" width="540" height="1090" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_normalization" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;1. Text Normalization&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Clean noise, tags, timestamps&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; font-style: italic; color: #666666;&quot;&gt;e.g. '[01:23] Hello!' -&gt; 'Hello!' | '&amp;lt;i&amp;gt;Bonjour&amp;lt;/i&amp;gt;' -&gt; 'Bonjour'&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c8a49;strokeWidth=2;fontColor=#1e293b;fontFamily=Comic Sans MS,cursive;fontStyle=0;sketch=1;align=left;spacingLeft=58;" vertex="1" parent="group_0">
          <mxGeometry x="45" y="45" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_normalization_icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.simpleicons.org/python;pointerEvents=0;" vertex="1" parent="nlp_normalization">
          <mxGeometry x="15" y="30" width="32" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_tokenizer" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;2. spaCy Tokenizer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Split into sentences/words&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; font-style: italic; color: #666666;&quot;&gt;e.g. 'Hello world' -&gt; ['Hello', 'world'] | &quot;don't&quot; -&gt; [&quot;do&quot;, &quot;n't&quot;]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c8a49;strokeWidth=2;fontColor=#1e293b;fontFamily=Comic Sans MS,cursive;fontStyle=0;sketch=1;align=left;spacingLeft=58;" vertex="1" parent="group_0">
          <mxGeometry x="45" y="195" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_tokenizer_icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.simpleicons.org/spacy;pointerEvents=0;" vertex="1" parent="nlp_tokenizer">
          <mxGeometry x="15" y="30" width="32" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_pos_tagger" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;3. POS Tagging&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Context-aware part of speech&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; font-style: italic; color: #666666;&quot;&gt;e.g. '... I am learning ...' -&gt; VERB | '... study guide ...' -&gt; NOUN&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c8a49;strokeWidth=2;fontColor=#1e293b;fontFamily=Comic Sans MS,cursive;fontStyle=0;sketch=1;align=left;spacingLeft=58;" vertex="1" parent="group_0">
          <mxGeometry x="45" y="345" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_pos_tagger_icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.simpleicons.org/spacy;pointerEvents=0;" vertex="1" parent="nlp_pos_tagger">
          <mxGeometry x="15" y="30" width="32" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_ner_filter" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;4. NER Filtering&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Exclude names &amp;amp; locations&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; font-style: italic; color: #666666;&quot;&gt;e.g. 'London', 'John' -&gt; Excluded | 'Google', 'French' -&gt; Excluded&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c8a49;strokeWidth=2;fontColor=#1e293b;fontFamily=Comic Sans MS,cursive;fontStyle=0;sketch=1;align=left;spacingLeft=58;" vertex="1" parent="group_0">
          <mxGeometry x="45" y="495" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_ner_filter_icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.simpleicons.org/spacy;pointerEvents=0;" vertex="1" parent="nlp_ner_filter">
          <mxGeometry x="15" y="30" width="32" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_lemmatizer" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;5. Lemmatizer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Extract dictionary base form&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; font-style: italic; color: #666666;&quot;&gt;e.g. 'studies' -&gt; 'study' | 'went' -&gt; 'go'&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c8a49;strokeWidth=2;fontColor=#1e293b;fontFamily=Comic Sans MS,cursive;fontStyle=0;sketch=1;align=left;spacingLeft=58;" vertex="1" parent="group_0">
          <mxGeometry x="45" y="645" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_lemmatizer_icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.simpleicons.org/spacy;pointerEvents=0;" vertex="1" parent="nlp_lemmatizer">
          <mxGeometry x="15" y="30" width="32" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_aggregator" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;6. Vocab Aggregator&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Group unique lemmas &amp;amp; counts&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; font-style: italic; color: #666666;&quot;&gt;e.g. ['study', 'study'] -&gt; count=2 | ['go', 'went', 'go'] -&gt; count=3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c8a49;strokeWidth=2;fontColor=#1e293b;fontFamily=Comic Sans MS,cursive;fontStyle=0;sketch=1;align=left;spacingLeft=58;" vertex="1" parent="group_0">
          <mxGeometry x="45" y="795" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_aggregator_icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.simpleicons.org/python;pointerEvents=0;" vertex="1" parent="nlp_aggregator">
          <mxGeometry x="15" y="30" width="32" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_cefr_scorer" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;7. CEFR Grading&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Assign difficulty per lemma&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; font-style: italic; color: #666666;&quot;&gt;e.g. 'study' -&gt; A2 (Candidate) | 'extraordinary' -&gt; B2 (Candidate)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c8a49;strokeWidth=2;fontColor=#1e293b;fontFamily=Comic Sans MS,cursive;fontStyle=0;sketch=1;align=left;spacingLeft=58;" vertex="1" parent="group_0">
          <mxGeometry x="45" y="945" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="nlp_cefr_scorer_icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.simpleicons.org/python;pointerEvents=0;" vertex="1" parent="nlp_cefr_scorer">
          <mxGeometry x="15" y="30" width="32" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="Clean text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#555555;jumpStyle=arc;jumpSize=6;fontFamily=Comic Sans MS,cursive;fontStyle=0;" edge="1" parent="1" source="nlp_normalization" target="nlp_tokenizer">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="150"/><mxPoint x="280" y="190"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="Tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#555555;jumpStyle=arc;jumpSize=6;fontFamily=Comic Sans MS,cursive;fontStyle=0;" edge="1" parent="1" source="nlp_tokenizer" target="nlp_pos_tagger">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="300"/><mxPoint x="280" y="340"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Tagged tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#555555;jumpStyle=arc;jumpSize=6;fontFamily=Comic Sans MS,cursive;fontStyle=0;" edge="1" parent="1" source="nlp_pos_tagger" target="nlp_ner_filter">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="450"/><mxPoint x="280" y="490"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Filtered tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#555555;jumpStyle=arc;jumpSize=6;fontFamily=Comic Sans MS,cursive;fontStyle=0;" edge="1" parent="1" source="nlp_ner_filter" target="nlp_lemmatizer">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="600"/><mxPoint x="280" y="640"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Lemmas list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#555555;jumpStyle=arc;jumpSize=6;fontFamily=Comic Sans MS,cursive;fontStyle=0;" edge="1" parent="1" source="nlp_lemmatizer" target="nlp_aggregator">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="750"/><mxPoint x="280" y="790"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="Aggregated counts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#555555;jumpStyle=arc;jumpSize=6;fontFamily=Comic Sans MS,cursive;fontStyle=0;" edge="1" parent="1" source="nlp_aggregator" target="nlp_cefr_scorer">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="900"/><mxPoint x="280" y="940"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
